<?if $(sys.BUILDARCH)="x86"?>
    <?define Win64 = "no" ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?elseif $(sys.BUILDARCH)="x64"?>
    <?define Win64 = "yes" ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?elseif $(sys.BUILDARCH)="arm64"?>
    <?define Win64 = "yes" ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else?>
    <?error Unsupported value of sys.BUILDARCH=$(sys.BUILDARCH)?>
<?endif?>

<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Product
            Id="*"
            Name="{{product_name}}"
            UpgradeCode="{{upgrade_code}}"
            Language="!(loc.TauriLanguage)"
            Manufacturer="{{manufacturer}}"
            Version="{{version}}">

        <Package Id="*"
                 Keywords="Installer"
                 InstallerVersion="450"
                 Languages="0"
                 Compressed="yes"
                 InstallScope="perMachine"
                 InstallPrivileges="elevated"
                 SummaryCodepage="!(loc.TauriCodepage)"/>

        <Property Id="REINSTALLMODE" Value="amus" />
        <Property Id="MsiLogging" Value="voicewarmupx" />

        <Property Id="AUTOLAUNCHAPP" Secure="yes" />
        <Property Id="LAUNCHAPPARGS" Secure="yes" />

        {{#if allow_downgrades}}
            <MajorUpgrade Schedule="afterInstallInitialize" AllowDowngrades="yes" />
        {{else}}
            <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="!(loc.DowngradeErrorMessage)" AllowSameVersionUpgrades="yes" />
        {{/if}}

        <InstallExecuteSequence>
            <RemoveShortcuts>Installed AND NOT UPGRADINGPRODUCTCODE</RemoveShortcuts>
            <Custom Action="KillAppOnInstall" Before="InstallFiles">NOT REMOVE</Custom>
            <Custom Action="KillAppOnUninstall" Before="RemoveFiles">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
            <Custom Action="RemoveBackupsOnly" Before="RemoveFiles">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE AND REMOVAL_SCOPE = "1"</Custom>
            <Custom Action="RemoveSystemDataOnly" Before="RemoveFiles">REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE AND REMOVAL_SCOPE = "2"</Custom>
            <Custom Action="SetDataDirPermissions" After="InstallFiles">NOT REMOVE</Custom>
            <Custom Action="SetInstallDirPermissions" After="InstallFiles">NOT REMOVE</Custom>
        </InstallExecuteSequence>

        <Media Id="1" Cabinet="app.cab" EmbedCab="yes" />

        {{#if banner_path}}
        <WixVariable Id="WixUIBannerBmp" Value="{{banner_path}}" />
        {{/if}}
        {{#if dialog_image_path}}
        <WixVariable Id="WixUIDialogBmp" Value="{{dialog_image_path}}" />
        {{/if}}
        {{#if license}}
        <WixVariable Id="WixUILicenseRtf" Value="{{license}}" />
        {{/if}}

        <Icon Id="ProductIcon" SourceFile="{{icon_path}}"/>
        <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
        <Property Id="ARPNOREPAIR" Value="yes" Secure="yes" />
        <SetProperty Id="ARPNOMODIFY" Value="1" After="InstallValidate" Sequence="execute"/>

        {{#if homepage}}
        <Property Id="ARPURLINFOABOUT" Value="{{homepage}}"/>
        <Property Id="ARPHELPLINK" Value="{{homepage}}"/>
        <Property Id="ARPURLUPDATEINFO" Value="{{homepage}}"/>
        {{/if}}

        <Binary Id="LicenseValidator"
                SourceFile="..\..\..\..\instalador_dll.dll" />

        <CustomAction Id="ValidateLicenseAction"
                      BinaryKey="LicenseValidator"
                      DllEntry="ValidateLicense"
                      Execute="immediate"
                      Return="check" />

        <CustomAction Id="KillAppOnInstall"
                      Impersonate="yes"
                      Execute="immediate"
                      Directory="INSTALLDIR"
                      ExeCommand='[System64Folder]cmd.exe /c taskkill /f /t /im "{{product_name}}.exe" 2>nul &amp; ping 127.0.0.1 -n 3 1>nul &amp; taskkill /f /t /im "{{product_name}}.exe" 2>nul &amp; powershell.exe -NoProfile -Command "Get-CimInstance Win32_Process | Where-Object { $_.Name -eq &apos;msedgewebview2.exe&apos; -and $_.CommandLine -like &apos;*com.cuidarerp.vda*&apos; } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }" 2>nul'
                      Return="ignore" />

        <CustomAction Id="KillAppOnUninstall"
                      Impersonate="yes"
                      Execute="immediate"
                      Directory="INSTALLDIR"
                      ExeCommand='[System64Folder]cmd.exe /c taskkill /f /t /im "{{product_name}}.exe" 2>nul &amp; ping 127.0.0.1 -n 3 1>nul &amp; taskkill /f /t /im "{{product_name}}.exe" 2>nul &amp; powershell.exe -NoProfile -Command "Get-CimInstance Win32_Process | Where-Object { $_.Name -eq &apos;msedgewebview2.exe&apos; -and $_.CommandLine -like &apos;*com.cuidarerp.vda*&apos; } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue }" 2>nul'
                      Return="ignore" />

        <CustomAction Id="RemoveBackupsOnly"
                      Impersonate="yes"
                      Execute="immediate"
                      Directory="TARGETDIR"
                      ExeCommand="[System64Folder]cmd.exe /c rmdir /s /q &quot;%USERPROFILE%\Documents\Cuidar-ERP&quot; 2>nul &amp; rmdir /s /q &quot;%USERPROFILE%\Documents\Backup - CuidarERP-VDA&quot; 2>nul"
                      Return="ignore" />

        <CustomAction Id="RemoveSystemDataOnly"
                      Impersonate="yes"
                      Execute="immediate"
                      Directory="TARGETDIR"
                      ExeCommand="[System64Folder]cmd.exe /c rmdir /s /q &quot;%ProgramData%\Cuidar-ERP-VDA&quot; 2>nul &amp; rmdir /s /q &quot;[INSTALLDIR]Data&quot; 2>nul &amp; rmdir /s /q &quot;%LOCALAPPDATA%\com.cuidarerp.vda&quot; 2>nul"
                      Return="ignore" />

        <CustomAction Id="SetDataDirPermissions"
                      Impersonate="no"
                      Execute="deferred"
                      Directory="INSTALLDIR"
                      ExeCommand='[System64Folder]cmd.exe /c if not exist &quot;[AppProgramDataDir]&quot; mkdir &quot;[AppProgramDataDir]&quot; &amp; icacls &quot;C:\ProgramData\Cuidar-ERP-VDA&quot; /grant &quot;*S-1-5-32-545:(OI)(CI)M&quot; /q 2>nul &amp; icacls &quot;[AppProgramDataDir]&quot; /grant &quot;*S-1-5-32-545:(OI)(CI)M&quot; /q 2>nul &amp; icacls &quot;Data&quot; /grant &quot;*S-1-5-32-545:(OI)(CI)M&quot; /q 2>nul'
                      Return="ignore" />

        <CustomAction Id="SetInstallDirPermissions"
                      Impersonate="no"
                      Execute="deferred"
                      Directory="INSTALLDIR"
                      ExeCommand='[System64Folder]cmd.exe /c icacls "." /grant "*S-1-5-32-545:(OI)(CI)M" /q 2>nul'
                      Return="ignore" />

        <Property Id="INSTALLDIR">
          <RegistrySearch Id="PrevInstallDirNoName" Root="HKCU" Key="Software\\{{manufacturer}}\\{{product_name}}" Type="raw" />
          <RegistrySearch Id="PrevInstallDirWithName" Root="HKCU" Key="Software\\{{manufacturer}}\\{{product_name}}" Name="InstallDir" Type="raw" />
        </Property>

        <Property Id="REMOVAL_SCOPE" Value="0" Secure="yes" />
        <Property Id="LICENSEVALID" />

        <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="!(loc.LaunchApp)" />
        <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1"/>
        <CustomAction Id="LaunchApplication" Impersonate="yes" FileKey="Path" ExeCommand="[LAUNCHAPPARGS]" Return="asyncNoWait" />

        <UI>
            <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed</Publish>

            <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />

            <Dialog Id="LicenseDlg" Width="370" Height="270" Title="Licença">
                <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
                <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
                <Control Id="Description" Type="Text" X="25" Y="55" Width="320" Height="20" Transparent="yes" NoPrefix="yes">
                  <Text>Digite a chave de licença recebida para ativar o Cuidar ERP.</Text>
                </Control>
                <Control Id="Title" Type="Text" X="25" Y="20" Width="320" Height="20" Transparent="yes" NoPrefix="yes">
                  <Text>{\WixUI_Font_Title}Chave de Licença</Text>
                </Control>
                <Control Id="LicenseKeyLabel" Type="Text" X="25" Y="85" Width="320" Height="15">
                  <Text>&amp;Chave de licença:</Text>
                </Control>
                <Control Id="LicenseKey" Type="Edit" X="25" Y="102" Width="320" Height="18" Property="LICENSEKEY" />
                <Control Id="InvalidMsg" Type="Text" X="25" Y="125" Width="320" Height="20" Text="Chave inválida. Verifique e tente novamente." Hidden="yes">
                  <Condition Action="show">LICENSEVALID = "0"</Condition>
                  <Condition Action="hide">LICENSEVALID &lt;&gt; "0"</Condition>
                </Control>
                <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
                  <Publish Event="DoAction" Value="ValidateLicenseAction" Order="1">LICENSEKEY &lt;&gt; ""</Publish>
                  <Publish Event="NewDialog" Value="InstallDirDlg" Order="2">LICENSEVALID = "1"</Publish>
                </Control>
                <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
                  <Publish Event="NewDialog" Value="LicenseAgreementDlg">1</Publish>
                </Control>
                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
                  <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
                </Control>
            </Dialog>

            <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="LicenseAgreementDlg">1</Publish>
            <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="LicenseDlg" Order="2">LicenseAccepted = "1"</Publish>
            <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="LicenseDlg" Order="2">1</Publish>

            <!-- Redirect MaintenanceTypeDlg Remove to UserDataDlg for uninstall.
                 Order="2" é obrigatório: a linha nativa (RemoveButton -> VerifyReadyDlg)
                 tem Ordering=1; com empate a NATIVA vence e nosso diálogo nunca aparece. -->
            <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="UserDataDlg" Order="2">1</Publish>
            <!-- Botão Voltar do VerifyReadyDlg retorna às opções de dados na desinstalação -->
            <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="UserDataDlg" Order="3">Installed AND NOT PATCH AND REMOVE="ALL"</Publish>

            <!-- UserDataDlg: escolha granular do que remover durante a desinstalação -->
            <Dialog Id="UserDataDlg" Width="370" Height="270" Title="Opções de Dados na Desinstalação" NoMinimize="yes">
                <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
                <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
                <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
                <Control Id="Title" Type="Text" X="15" Y="55" Width="300" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}O que fazer com os dados?" />
                <Control Id="Description" Type="Text" X="25" Y="75" Width="320" Height="30" Transparent="yes" NoPrefix="yes" Text="Escolha o que será removido junto com o programa." />
                <Control Id="RemovalScopeGroup" Type="RadioButtonGroup" X="25" Y="112" Width="320" Height="80" Property="REMOVAL_SCOPE">
                    <RadioButtonGroup Property="REMOVAL_SCOPE">
                        <RadioButton Value="0" X="0" Y="0" Width="320" Height="18" Text="Desinstalar o programa" />
                        <RadioButton Value="1" X="0" Y="20" Width="320" Height="18" Text="Apagar dados de backup (Documents\Cuidar-ERP)" />
                        <RadioButton Value="2" X="0" Y="40" Width="320" Height="18" Text="Apagar dados do sistema (banco e perfil)" />
                    </RadioButtonGroup>
                </Control>
                <Control Id="RemoveDataWarning" Type="Text" X="25" Y="198" Width="320" Height="30" Text="Atenção: A remoção selecionada é permanente e não pode ser desfeita." />
                <Control Id="Remove" Type="PushButton" X="212" Y="243" Width="80" Height="17" Default="yes" Text="Remover">
                    <Publish Event="EndDialog" Value="Return">1</Publish>
                </Control>
                <Control Id="Back" Type="PushButton" X="156" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
                    <Publish Event="NewDialog" Value="MaintenanceTypeDlg">1</Publish>
                </Control>
                <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
                    <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
                </Control>
            </Dialog>
        </UI>

        <UIRef Id="WixUI_InstallDir" />

        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="$(var.PlatformProgramFilesFolder)" Name="PFiles">
                <Directory Id="INSTALLDIR" Name="{{product_name}}"/>
            </Directory>
            <Directory Id="ProgramDataFolder" Name="ProgramData">
                <Directory Id="AppProgramDataBase" Name="Cuidar-ERP-VDA">
                    <Directory Id="AppProgramDataDir" Name="Data" />
                </Directory>
            </Directory>
            <Directory Id="ProgramMenuFolder">
                <Directory Id="ApplicationProgramsFolder" Name="{{product_name}}"/>
            </Directory>
            <Directory Id="DesktopFolder" Name="Desktop" />
            <Directory Id="DocumentsFolder">
                <Directory Id="AppDocsFolder" Name="Cuidar-ERP">
                    <Directory Id="AppDocsBackupsFolder" Name="Backups" />
                </Directory>
            </Directory>
        </Directory>

        <DirectoryRef Id="INSTALLDIR">
            <Directory Id="DataDir" Name="Data" />
            <Directory Id="RestoreDir" Name="Restore" />
            <Component Id="RegistryEntries" Guid="*">
                <RegistryKey Root="HKCU" Key="Software\\{{manufacturer}}\\{{product_name}}">
                    <RegistryValue Name="InstallDir" Type="string" Value="[INSTALLDIR]" KeyPath="yes" />
                </RegistryKey>
                {{#each deep_link_protocols as |protocol| ~}}
                <RegistryKey Root="HKLM" Key="Software\Classes\\{{protocol}}">
                    <RegistryValue Type="string" Name="URL Protocol" Value=""/>
                    <RegistryValue Type="string" Value="URL:{{bundle_id}} protocol"/>
                    <RegistryKey Key="DefaultIcon">
                        <RegistryValue Type="string" Value="&quot;[!Path]&quot;,0" />
                    </RegistryKey>
                    <RegistryKey Key="shell\open\command">
                        <RegistryValue Type="string" Value="&quot;[!Path]&quot; &quot;%1&quot;" />
                    </RegistryKey>
                </RegistryKey>
                {{/each~}}
            </Component>
            <Component Id="Path" Guid="{{path_component_guid}}" Win64="$(var.Win64)">
                <File Id="Path" Source="{{main_binary_path}}" Name="{{product_name}}.exe" KeyPath="yes" Checksum="yes"/>
                {{#each file_associations as |association| ~}}
                {{#each association.ext as |ext| ~}}
                <ProgId Id="{{../../product_name}}.{{ext}}" Advertise="yes" Description="{{association.description}}">
                    <Extension Id="{{ext}}" Advertise="yes">
                        <Verb Id="open" Command="Open with {{../../product_name}}" Argument="&quot;%1&quot;" />
                    </Extension>
                </ProgId>
                {{/each~}}
                {{/each~}}
            </Component>
            {{#each binaries as |bin| ~}}
            <Component Id="{{ bin.id }}" Guid="{{bin.guid}}" Win64="$(var.Win64)">
                <File Id="Bin_{{ bin.id }}" Source="{{bin.path}}" KeyPath="yes"/>
            </Component>
            {{/each~}}
            {{#if enable_elevated_update_task}}
            <Component Id="UpdateTask" Guid="C492327D-9720-4CD5-8DB8-F09082AF44BE" Win64="$(var.Win64)">
                <File Id="UpdateTask" Source="update.xml" KeyPath="yes" Checksum="yes"/>
            </Component>
            <Component Id="UpdateTaskInstaller" Guid="011F25ED-9BE3-50A7-9E9B-3519ED2B9932" Win64="$(var.Win64)">
                <File Id="UpdateTaskInstaller" Source="install-task.ps1" KeyPath="yes" Checksum="yes"/>
            </Component>
            <Component Id="UpdateTaskUninstaller" Guid="D4F6CC3F-32DC-5FD0-95E8-782FFD7BBCE1" Win64="$(var.Win64)">
                <File Id="UpdateTaskUninstaller" Source="uninstall-task.ps1" KeyPath="yes" Checksum="yes"/>
            </Component>
            {{/if}}
            {{resources}}

            <Component Id="ResetBat" Guid="*" Win64="$(var.Win64)">
                <File Id="ResetBat" Source="..\..\..\..\reset.bat" KeyPath="yes" Checksum="yes"/>
            </Component>

            <Component Id="AppDataDir" Guid="*" Win64="$(var.Win64)">
                <CreateFolder Directory="DataDir" />
                <RegistryValue Root="HKCU" Key="Software\\{{manufacturer}}\\{{product_name}}" Name="DataDir" Type="integer" Value="1" KeyPath="yes" />
            </Component>

            <Component Id="AppRestoreDir" Guid="*" Win64="$(var.Win64)">
                <CreateFolder Directory="RestoreDir" />
                <RegistryValue Root="HKCU" Key="Software\\{{manufacturer}}\\{{product_name}}" Name="RestoreDir" Type="integer" Value="1" KeyPath="yes" />
            </Component>

            <Component Id="AppProgramDataComponent" Guid="*" Win64="$(var.Win64)">
                <CreateFolder Directory="AppProgramDataDir" />
                <RegistryValue Root="HKCU" Key="Software\\{{manufacturer}}\\{{product_name}}" Name="ProgramDataDir" Type="integer" Value="1" KeyPath="yes" />
            </Component>

            <Component Id="AppDocsBackupsDir" Guid="*" Win64="$(var.Win64)">
                <CreateFolder Directory="AppDocsBackupsFolder" />
                <RegistryValue Root="HKCU" Key="Software\\{{manufacturer}}\\{{product_name}}" Name="DocsBackupsDir" Type="integer" Value="1" KeyPath="yes" />
            </Component>

            <Component Id="CMP_UninstallShortcut" Guid="*">
                <Shortcut Id="UninstallShortcut"
                          Name="Uninstall {{product_name}}"
                          Description="Uninstalls {{product_name}}"
                          Target="[System64Folder]msiexec.exe"
                          Arguments="/x [ProductCode]" />
                <RemoveFolder Id="INSTALLDIR" On="uninstall" />
                <RegistryValue Root="HKCU"
                               Key="Software\\{{manufacturer}}\\{{product_name}}"
                               Name="Uninstaller Shortcut"
                               Type="integer"
                               Value="1"
                               KeyPath="yes" />
            </Component>
        </DirectoryRef>

        <DirectoryRef Id="ApplicationProgramsFolder">
            <Component Id="ApplicationShortcut" Guid="*">
                <Shortcut Id="ApplicationStartMenuShortcut"
                    Name="{{product_name}}"
                    Description="Runs {{product_name}}"
                    Target="[!Path]"
                    Icon="ProductIcon"
                    WorkingDirectory="INSTALLDIR">
                    <ShortcutProperty Key="System.AppUserModel.ID" Value="{{bundle_id}}"/>
                </Shortcut>
                <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall"/>
                <RegistryValue Root="HKCU" Key="Software\\{{manufacturer}}\\{{product_name}}" Name="Start Menu Shortcut" Type="integer" Value="1" KeyPath="yes"/>
           </Component>
        </DirectoryRef>

        <DirectoryRef Id="DesktopFolder">
            <Component Id="DesktopShortcut" Guid="*">
                <Shortcut Id="ApplicationDesktopShortcut"
                    Name="{{product_name}}"
                    Description="Executa {{product_name}}"
                    Target="[!Path]"
                    Icon="ProductIcon"
                    WorkingDirectory="INSTALLDIR">
                    <ShortcutProperty Key="System.AppUserModel.ID" Value="{{bundle_id}}"/>
                </Shortcut>
                <RemoveFolder Id="DesktopFolder" On="uninstall"/>
                <RegistryValue Root="HKCU" Key="Software\\{{manufacturer}}\\{{product_name}}" Name="Desktop Shortcut" Type="integer" Value="1" KeyPath="yes"/>
            </Component>
        </DirectoryRef>

        {{#each merge_modules as |msm| ~}}
        <DirectoryRef Id="TARGETDIR">
            <Merge Id="{{ msm.name }}" SourceFile="{{ msm.path }}" DiskId="1" Language="!(loc.TauriLanguage)" />
        </DirectoryRef>
        <Feature Id="{{ msm.name }}" Title="{{ msm.name }}" AllowAdvertise="no" Display="hidden" Level="1">
            <MergeRef Id="{{ msm.name }}"/>
        </Feature>
        {{/each~}}

        <Feature
                Id="MainProgram"
                Title="Application"
                Description="!(loc.InstallAppFeature)"
                Level="1"
                ConfigurableDirectory="INSTALLDIR"
                AllowAdvertise="no"
                Display="expand"
                Absent="disallow">

            <ComponentRef Id="RegistryEntries"/>

            {{#each resource_file_ids as |resource_file_id| ~}}
                <ComponentRef Id="{{ resource_file_id }}"/>
            {{/each~}}

            {{#if enable_elevated_update_task}}
                <ComponentRef Id="UpdateTask" />
                <ComponentRef Id="UpdateTaskInstaller" />
                <ComponentRef Id="UpdateTaskUninstaller" />
            {{/if}}

            <Feature Id="ShortcutsFeature"
                Title="Shortcuts"
                Level="1">
                <ComponentRef Id="Path"/>
                <ComponentRef Id="CMP_UninstallShortcut" />
                <ComponentRef Id="ApplicationShortcut" />
                <ComponentRef Id="DesktopShortcut" />
            </Feature>

            <ComponentRef Id="ResetBat" />
            <ComponentRef Id="AppDataDir" />
            <ComponentRef Id="AppRestoreDir" />
            <ComponentRef Id="AppProgramDataComponent" />
            <ComponentRef Id="AppDocsBackupsDir" />

            <Feature
                Id="Environment"
                Title="PATH Environment Variable"
                Description="!(loc.PathEnvVarFeature)"
                Level="1"
                Absent="allow">
            <ComponentRef Id="Path"/>
            {{#each binaries as |bin| ~}}
            <ComponentRef Id="{{ bin.id }}"/>
            {{/each~}}
            </Feature>
        </Feature>

        <Feature Id="External" AllowAdvertise="no" Absent="disallow">
            {{#each component_group_refs as |id| ~}}
            <ComponentGroupRef Id="{{ id }}"/>
            {{/each~}}
            {{#each component_refs as |id| ~}}
            <ComponentRef Id="{{ id }}"/>
            {{/each~}}
            {{#each feature_group_refs as |id| ~}}
            <FeatureGroupRef Id="{{ id }}"/>
            {{/each~}}
            {{#each feature_refs as |id| ~}}
            <FeatureRef Id="{{ id }}"/>
            {{/each~}}
            {{#each merge_refs as |id| ~}}
            <MergeRef Id="{{ id }}"/>
            {{/each~}}
        </Feature>

        {{#if install_webview}}
        <Property Id="INSTALLED_WEBVIEW2_VERSION">
            <RegistrySearch Id="Webview2VersionSystemx64" Root="HKLM" Key="SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" Name="pv" Type="raw" />
            <RegistrySearch Id="Webview2VersionSystemx86" Root="HKLM" Key="SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" Name="pv" Type="raw" />
            <RegistrySearch Id="Webview2VersionUser" Root="HKCU" Key="SOFTWARE\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}" Name="pv" Type="raw"/>
        </Property>

        {{#if download_bootstrapper}}
        <CustomAction Id='DownloadAndInvokeBootstrapper' Directory="INSTALLDIR" Execute="deferred" ExeCommand='powershell.exe -NoProfile -windowstyle hidden try [\{] [\[]Net.ServicePointManager[\]]::SecurityProtocol = [\[]Net.SecurityProtocolType[\]]::Tls12 [\}] catch [\{][\}]; Invoke-WebRequest -Uri "https://go.microsoft.com/fwlink/p/?LinkId=2124703" -OutFile "$env:TEMP\MicrosoftEdgeWebview2Setup.exe" ; Start-Process -FilePath "$env:TEMP\MicrosoftEdgeWebview2Setup.exe" -ArgumentList ({{webview_installer_args}} &apos;/install&apos;) -Wait' Return='check'/>
        <InstallExecuteSequence>
            <Custom Action='DownloadAndInvokeBootstrapper' Before='InstallFinalize'>
                <![CDATA[NOT(REMOVE OR INSTALLED_WEBVIEW2_VERSION)]]>
            </Custom>
        </InstallExecuteSequence>
        {{/if}}

        {{#if webview2_bootstrapper_path}}
        <Binary Id="MicrosoftEdgeWebview2Setup.exe" SourceFile="{{webview2_bootstrapper_path}}"/>
        <CustomAction Id='InvokeBootstrapper' BinaryKey='MicrosoftEdgeWebview2Setup.exe' Execute="deferred" ExeCommand='{{webview_installer_args}} /install' Return='check' />
        <InstallExecuteSequence>
            <Custom Action='InvokeBootstrapper' Before='InstallFinalize'>
                <![CDATA[NOT(REMOVE OR INSTALLED_WEBVIEW2_VERSION)]]>
            </Custom>
        </InstallExecuteSequence>
        {{/if}}

        {{#if webview2_installer_path}}
        <Binary Id="MicrosoftEdgeWebView2RuntimeInstaller.exe" SourceFile="{{webview2_installer_path}}"/>
        <CustomAction Id='InvokeStandalone' BinaryKey='MicrosoftEdgeWebView2RuntimeInstaller.exe' Execute="deferred" ExeCommand='{{webview_installer_args}} /install' Return='check' />
        <InstallExecuteSequence>
            <Custom Action='InvokeStandalone' Before='InstallFinalize'>
                <![CDATA[NOT(REMOVE OR INSTALLED_WEBVIEW2_VERSION)]]>
            </Custom>
        </InstallExecuteSequence>
        {{/if}}

        {{#if minimum_webview2_version}}
        <Property Id="MINIMUM_WEBVIEW2_VERSION" Value="{{minimum_webview2_version}}" />
        <Property Id="EDGEUPDATE_PATH">
            <RegistrySearch Id="EdgeUpdateLocalMachine64" Root="HKLM" Key="SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate" Name="path" Type="raw" />
            <RegistrySearch Id="EdgeUpdateLocalMachine32" Root="HKLM" Key="SOFTWARE\Microsoft\EdgeUpdate" Name="path" Type="raw"/>
            <RegistrySearch Id="EdgeUpdateCurrentUser" Root="HKCU" Key="SOFTWARE\Microsoft\EdgeUpdate" Name="path" Type="raw"/>
        </Property>
        <CustomAction Id="UpdateWebView2ViaEdgeUpdate" Execute="deferred" Property="EDGEUPDATE_PATH" Return="check" Impersonate="no" ExeCommand="/install appguid={F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}&amp;needsadmin=true" />
        <InstallExecuteSequence>
            <Custom Action='UpdateWebView2ViaEdgeUpdate' Before='InstallFinalize'>
                <![CDATA[
                  NOT REMOVE
                  AND INSTALLED_WEBVIEW2_VERSION
                  AND (INSTALLED_WEBVIEW2_VERSION < MINIMUM_WEBVIEW2_VERSION)
                ]]>
            </Custom>
        </InstallExecuteSequence>
        {{/if}}

        {{/if}}

        {{#if enable_elevated_update_task}}
        <CustomAction
            Id="CreateUpdateTask"
            Return="check"
            Directory="INSTALLDIR"
            Execute="commit"
            Impersonate="yes"
            ExeCommand="powershell.exe -WindowStyle hidden .\install-task.ps1" />
        <InstallExecuteSequence>
            <Custom Action='CreateUpdateTask' Before='InstallFinalize'>
                NOT(REMOVE)
            </Custom>
        </InstallExecuteSequence>
        <CustomAction
            Id="DeleteUpdateTask"
            Return="check"
            Directory="INSTALLDIR"
            ExeCommand="powershell.exe -WindowStyle hidden .\uninstall-task.ps1" />
        <InstallExecuteSequence>
            <Custom Action="DeleteUpdateTask" Before='InstallFinalize'>
                (REMOVE = "ALL") AND NOT UPGRADINGPRODUCTCODE
            </Custom>
        </InstallExecuteSequence>
        {{/if}}

        <InstallExecuteSequence>
          <Custom Action="LaunchApplication" After="InstallFinalize">AUTOLAUNCHAPP AND NOT Installed</Custom>
        </InstallExecuteSequence>

        <SetProperty Id="ARPINSTALLLOCATION" Value="[INSTALLDIR]" After="CostFinalize"/>
    </Product>
</Wix>
