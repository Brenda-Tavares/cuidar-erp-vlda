<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <Binary Id="LicenseValidator"
            SourceFile="..\..\instalador-dll\target\release\instalador_dll.dll" />

    <CustomAction Id="ValidateLicenseAction"
                  BinaryKey="LicenseValidator"
                  DllEntry="ValidateLicense"
                  Execute="immediate"
                  Return="check" />

    <Property Id="LICENSEVALID" Value="0" />

    <UI>
      <Dialog Id="LicenseDlg" Width="370" Height="270" Title="Licença">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Description" Type="Text" X="25" Y="55" Width="320" Height="20" Transparent="yes" NoPrefix="yes">
          <Text>Digite a chave de licença recebida para ativar o Cuidar ERP.</Text>
        </Control>
        <Control Id="Title" Type="Text" X="25" Y="20" Width="320" Height="20" Transparent="yes" NoPrefix="yes">
          <Text>{\WixUI_Font_Title}Chave de Licença</Text>
        </Control>
        <Control Id="LicenseKeyLabel" Type="Text" X="25" Y="85" Width="320" Height="15">
          <Text>&amp;Chave de licença:</Text>
        </Control>
        <Control Id="LicenseKey" Type="Edit" X="25" Y="102" Width="320" Height="18" Property="LICENSEKEY" />
        <Control Id="InvalidMsg" Type="Text" X="25" Y="125" Width="320" Height="20" Text="Chave inválida. Verifique e tente novamente." TextNoPrefix="yes" Hidden="yes">
          <Condition Action="show">LICENSEVALID = "0"</Condition>
          <Condition Action="hide">LICENSEVALID = "1"</Condition>
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes">
          <Publish Event="DoAction" Value="ValidateLicenseAction">LICENSEKEY &lt;&gt; ""</Publish>
          <Publish Event="NewDialog" Value="InstallDirDlg">LICENSEVALID = "1"</Publish>
        </Control>
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="WelcomeDlg">1</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes">
          <Publish Event="SpawnDialog" Value="CancelDlg">1</Publish>
        </Control>
      </Dialog>

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="LicenseDlg">1</Publish>
    </UI>
  </Fragment>
</Wix>
